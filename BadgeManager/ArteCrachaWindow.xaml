<Window x:Class="BadgeManager.ArteCrachaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arte do Crachá"
        Height="650"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Arte do Crachá"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Clique na imagem para salvar como PNG."
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,0,0,20"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="20">
                <Image x:Name="ImgArteCracha"
                       Stretch="Uniform"
                       Cursor="Hand"
                       MouseLeftButtonDown="ImgArteCracha_MouseLeftButtonDown"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>